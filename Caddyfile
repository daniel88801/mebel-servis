{$DOMAIN:localhost} {
	encode gzip zstd

	# Журнал запросов: нужен, чтобы видеть краулеров соцсетей и поисковиков
	# и понимать, что именно они получили.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_ip}
		header_up X-Forwarded-Proto {scheme}

		# При выкатке контейнер пересоздаётся и несколько десятков секунд
		# не принимает соединения. Без этого Caddy сразу отдаёт 502, и краулер
		# запоминает страницу как сломанную. Вместо ошибки — ждём и повторяем.
		lb_try_duration 45s
		lb_try_interval 500ms
	}
}
