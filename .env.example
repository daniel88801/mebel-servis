# --- Почта: основной канал уведомлений -------------------------------------
# С сервера закрыты обычные порты SMTP (25, 465, 587) — это антиспам-политика
# хостинга. Открыт 2525, на нём работают релеи почтовых сервисов.
#
# Быстрый путь: завести аккаунт в любом релее (Brevo, Mailgun, SendGrid,
# Resend, SMTP.bz), подтвердить домен meb-srv.ru и взять там логин с паролем.
# Альтернатива: попросить хостинг открыть порт 465 — тогда сюда подойдут
# smtp.mail.ru и ваш обычный ящик.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
# От кого приходит письмо. Домен должен быть подтверждён у релея.
SMTP_FROM=Мебель-Сервис <robot@meb-srv.ru>
# Кому падают уведомления. По умолчанию — почта из реквизитов компании.
LEAD_EMAIL_TO=m1-mebelservis-nn@mail.ru

# --- Telegram: сейчас не работает ------------------------------------------
# api.telegram.org с этого сервера недоступен. Оставлено на случай, если
# появится прокси или сменится хостинг: при пустых значениях канал молчит.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Служебная лента --------------------------------------------------------
# Пароль к /inbox. Генерируется при первом развёртывании, менять вручную.
INBOX_PASSWORD=

# --- Прочее -----------------------------------------------------------------
# Боевой адрес: попадает в sitemap.xml, robots.txt, микроразметку и превью.
NEXT_PUBLIC_SITE_URL=https://meb-srv.ru
DOMAIN=meb-srv.ru
# Яндекс.Метрика: номер счётчика. Пусто — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
