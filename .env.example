# Заявки с форм уходят в Telegram.
# 1. Создайте бота у @BotFather и скопируйте токен.
# 2. Напишите боту из чата (или добавьте его в группу менеджеров).
# 3. Узнайте chat_id: https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Боевой адрес — попадает в sitemap.xml, robots.txt и микроразметку.
NEXT_PUBLIC_SITE_URL=https://mebel-servis-nn.ru

# Яндекс.Метрика: номер счётчика. Пустое значение — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
