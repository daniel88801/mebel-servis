# Telegram получает только номер заявки/заказа, без ФИО и телефона.
# Полные данные — в SQLite на сервере в РФ и в служебной ленте /inbox.
# 1. Создайте бота у @BotFather и скопируйте токен.
# 2. Напишите боту из чата (или добавьте его в группу менеджеров).
# 3. Узнайте chat_id: https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль служебной ленты заявок: https://meb-srv.ru/inbox
INBOX_PASSWORD=

# Боевой адрес — попадает в sitemap.xml, robots.txt и микроразметку.
# NEXT_PUBLIC_* вшиваются в клиент на этапе docker build.
NEXT_PUBLIC_SITE_URL=https://meb-srv.ru

# Домен для Caddy (Let's Encrypt). Локально оставьте localhost.
DOMAIN=meb-srv.ru

# Яндекс.Метрика: номер счётчика. Грузится только после «Принять все».
NEXT_PUBLIC_YANDEX_METRIKA_ID=
